# Copy this file to .env (same folder) and set the password.
# The PAN is already a live box. This is not a ZTP or ESXi install.
# Terraform reads ISE_HOST, ISE_USERNAME, ISE_PASSWORD from .env (see README).

ISE_HOST=192.168.1.90
ISE_HOSTNAME=pan1
ISE_USERNAME=admin
# Put the lab admin password here. Do not commit .env.
ISE_PASSWORD=changeme
ISE_GATEWAY=192.168.1.10
ISE_NTP=192.168.1.10
ISE_DNS=192.168.1.46
ISE_DOMAIN=test.lab
ISE_NETMASK=255.255.255.0
ISE_MASK=/24
